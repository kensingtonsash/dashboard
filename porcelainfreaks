<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Porcelain Freaks — Vintage China Stock</title>

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      html, body, #root { height: 100%; }

      body {
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: #eceef2;
        color: #16233f;
        -webkit-font-smoothing: antialiased;
      }

      button { cursor: pointer; border: none; font-family: inherit; }
      input, select { font-family: inherit; outline: none; }
      input:focus, select:focus { border-color: #243c86 !important; }
      table { border-spacing: 0; }

      /* Minimal layout utilities used across components */
      .flex { display: flex; }
      .grid { display: grid; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .items-center { align-items: center; }
      .items-end { align-items: flex-end; }
      .justify-between { justify-content: space-between; }
      .justify-end { justify-content: flex-end; }
      .gap-1 { gap: 4px; }
      .gap-1\.5 { gap: 6px; }
      .gap-2 { gap: 8px; }
      .gap-3 { gap: 12px; }
      .gap-6 { gap: 24px; }

      @media (max-width: 720px) {
        .grid { grid-template-columns: 1fr !important; }
      }
    </style>

    <!-- React, ReactDOM and lucide-react, loaded as ES modules from a CDN.
         The import map lets the inlined code below use the same bare
         imports ("react", "lucide-react") it used as a Vite project. -->
    <script type="importmap">
      {
        "imports": {
          "react": "https://esm.sh/react@18.3.1",
          "react-dom/client": "https://esm.sh/react-dom@18.3.1/client",
          "lucide-react": "https://esm.sh/lucide-react@0.383.0?deps=react@18.3.1"
        }
      }
    </script>

    <!-- Babel standalone transpiles the JSX in the browser, so there's no
         build step. Good for a one-file drop-in; for heavier use you'd move
         back to the Vite project. -->
    <script src="https://unpkg.com/@babel/standalone@7.24.7/babel.min.js"></script>
  </head>
  <body>
    <div id="root"></div>

    <script type="text/babel" data-type="module" data-presets="react">
      import React, { useState, useEffect, useMemo } from "react";
      import { createRoot } from "react-dom/client";
      import {
        Package, Boxes, Layers, Truck, TrendingUp, Wallet, Archive,
        Plus, RotateCcw, Ship, CircleDot, Trash2, X,
      } from "lucide-react";

      /* ======================================================================
         theme.js
         Palette rooted in the subject: underglaze cobalt, glaze white,
         antique gilt hairlines. The gold rule is the signature, echoing
         the gilt rim on a piece of fine china.
      ====================================================================== */
      const C = {
        ink: "#16233f",
        cobalt: "#243c86",
        cobaltSoft: "#3a55a8",
        porcelain: "#eceef2",
        surface: "#ffffff",
        gilt: "#b08d3c",
        giltSoft: "#cbb079",
        slate: "#5c6b86",
        line: "#dfe3ea",
      };

      const STATUSES = ["sourced", "in transit", "with rep", "listed", "sold"];

      const STATUS_STYLE = {
        sourced: { bg: "#eef0f4", fg: "#5c6b86" },
        "in transit": { bg: "#fbf1df", fg: "#a9772a" },
        "with rep": { bg: "#e6ecfb", fg: "#3a55a8" },
        listed: { bg: "#e4e9f7", fg: "#243c86" },
        sold: { bg: "#e5f0e7", fg: "#3f7a4d" },
      };

      /* ======================================================================
         lib/calc.js — landed-cost engine + rollups
      ====================================================================== */
      const money = (n) =>
        (n < 0 ? "-" : "") +
        "£" +
        Math.abs(n).toLocaleString("en-GB", { maximumFractionDigits: 0 });

      const pct = (n) =>
        n === null || !isFinite(n) ? "—" : Math.round(n) + "%";

      // A piece's true cost = what you paid the seller + its inbound shipping
      // + its share of the parcel it travelled in (outbound + customs),
      // apportioned across the parcel by value.
      function enrich(items, shipments) {
        const shipTotals = {};
        items.forEach((it) => {
          if (it.shipment)
            shipTotals[it.shipment] = (shipTotals[it.shipment] || 0) + it.purchase;
        });
        const shipMap = Object.fromEntries(shipments.map((s) => [s.id, s]));

        return items.map((it) => {
          const s = it.shipment ? shipMap[it.shipment] : null;
          let apportioned = 0;
          let estimated = false;
          if (s) {
            const parcelCost = (s.outbound || 0) + (s.customs || 0);
            const share = shipTotals[it.shipment]
              ? it.purchase / shipTotals[it.shipment]
              : 0;
            apportioned = parcelCost * share;
          } else if (it.status !== "sourced") {
            estimated = true; // will travel, but parcel costs aren't logged yet
          }
          const landed = it.purchase + (it.inbound || 0) + apportioned;
          const sold = it.status === "sold" && it.salePrice != null;
          const profit = sold ? it.salePrice - landed : null;
          const margin = sold && landed > 0 ? (profit / landed) * 100 : null;
          return { ...it, apportioned, landed, sold, profit, margin, estimated };
        });
      }

      function rollups(enriched) {
        const sold = enriched.filter((i) => i.sold);
        const stock = enriched.filter((i) => !i.sold);
        const revenue = sold.reduce((a, i) => a + i.salePrice, 0);
        const profit = sold.reduce((a, i) => a + i.profit, 0);
        const stockValue = stock.reduce((a, i) => a + i.landed, 0);
        const margins = sold.filter((i) => i.margin != null).map((i) => i.margin);
        const avgMargin = margins.length
          ? margins.reduce((a, b) => a + b, 0) / margins.length
          : null;
        return {
          revenue,
          profit,
          stockValue,
          inStock: stock.length,
          soldCount: sold.length,
          avgMargin,
        };
      }

      function byCollection(enriched) {
        const map = {};
        enriched.forEach((i) => {
          const key = i.collection || "Unassigned";
          if (!map[key])
            map[key] = {
              name: key,
              brand: i.brand,
              inStock: 0,
              sold: 0,
              profit: 0,
              stockValue: 0,
            };
          if (i.sold) {
            map[key].sold++;
            map[key].profit += i.profit;
          } else {
            map[key].inStock++;
            map[key].stockValue += i.landed;
          }
        });
        return Object.values(map).sort(
          (a, b) => b.inStock + b.sold - (a.inStock + a.sold)
        );
      }

      /* ======================================================================
         lib/storage.js — browser localStorage persistence
      ====================================================================== */
      const KEY = "porcelain-freaks:v1";

      function load() {
        try {
          const raw = localStorage.getItem(KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || !parsed.items) return null;
          return parsed;
        } catch {
          return null;
        }
      }

      function save(data) {
        try {
          localStorage.setItem(KEY, JSON.stringify(data));
        } catch {
          /* storage full or unavailable — fail quietly, app keeps working in-memory */
        }
      }

      /* ======================================================================
         data/seed.js — sample stock so the board reads as alive on first run
      ====================================================================== */
      const SEED = {
        items: [
          { id: "VB-BEN-001", product: "Benedikt teapot",        collection: "V&B Benedikt",                 brand: "Villeroy & Boch", source: "eBay UK",   purchase: 42, inbound: 6,  status: "listed",     listPrice: 210, salePrice: null, channel: null,    shipment: "P-001" },
          { id: "VB-BEN-002", product: "Benedikt sugar bowl",    collection: "V&B Benedikt",                 brand: "Villeroy & Boch", source: "eBay UK",   purchase: 28, inbound: 5,  status: "listed",     listPrice: 150, salePrice: null, channel: null,    shipment: "P-001" },
          { id: "VB-BEN-003", product: "Benedikt milk jug",      collection: "V&B Benedikt",                 brand: "Villeroy & Boch", source: "Vinted",    purchase: 22, inbound: 4,  status: "sold",       listPrice: 140, salePrice: 140,  channel: "Avito", shipment: "P-001" },
          { id: "VB-BUN-014", product: "Bunny Family plate",     collection: "V&B Bunny Family",             brand: "Villeroy & Boch", source: "Leboncoin", purchase: 18, inbound: 7,  status: "sold",       listPrice: 95,  salePrice: 105,  channel: "Avito", shipment: "P-001" },
          { id: "VB-BUN-015", product: "Bunny Family mug",       collection: "V&B Bunny Family",             brand: "Villeroy & Boch", source: "eBay UK",   purchase: 15, inbound: 4,  status: "with rep",   listPrice: 80,  salePrice: null, channel: null,    shipment: "P-002" },
          { id: "RD-BH-031",  product: "Brambly Hedge teapot",   collection: "Royal Doulton Brambly Hedge",  brand: "Royal Doulton",   source: "eBay UK",   purchase: 55, inbound: 8,  status: "listed",     listPrice: 260, salePrice: null, channel: null,    shipment: "P-002" },
          { id: "RD-BH-032",  product: "Brambly Hedge cup & saucer", collection: "Royal Doulton Brambly Hedge", brand: "Royal Doulton", source: "Subito.it", purchase: 30, inbound: 9, status: "in transit", listPrice: 130, salePrice: null, channel: null, shipment: "P-002" },
          { id: "CH-BUT-004", product: "Christofle butter dish", collection: "Christofle silver",            brand: "Christofle",      source: "eBay UK",   purchase: 60, inbound: 10, status: "sourced",    listPrice: 320, salePrice: null, channel: null,    shipment: null },
        ],
        shipments: [
          { id: "P-001", date: "2026-06-14", outbound: 45, customs: 38, note: "Mixed china batch → Moscow" },
          { id: "P-002", date: "2026-07-22", outbound: 52, customs: 60, note: "Doulton + Bunny Family" },
        ],
      };

      /* ======================================================================
         components/ui.jsx — buttons, KPI, cards, form fields
      ====================================================================== */
      const btnPrimary = { background: C.cobalt, color: "#fff", padding: "8px 14px", borderRadius: 6, fontSize: 13, fontWeight: 600 };
      const btnGhost = { background: C.surface, color: C.cobalt, padding: "8px 14px", borderRadius: 6, fontSize: 13, fontWeight: 600, border: `1px solid ${C.line}` };

      function Kpi({ icon, label, value, sub, accent }) {
        return (
          <div style={{ background: C.surface, border: `1px solid ${C.line}`, borderTop: `2px solid ${accent ? C.gilt : C.cobalt}`, borderRadius: 4, padding: "12px 14px" }}>
            <div className="flex items-center gap-1.5" style={{ color: C.slate, fontSize: 11.5, fontWeight: 600 }}>{icon}{label}</div>
            <div style={{ fontSize: 22, fontWeight: 700, marginTop: 6, color: accent ? C.gilt : C.ink, fontFamily: "ui-monospace, monospace" }}>{value}</div>
            {sub && <div style={{ fontSize: 10.5, color: C.slate, marginTop: 1 }}>{sub}</div>}
          </div>
        );
      }

      function Card({ title, hint, children }) {
        return (
          <div style={{ background: C.surface, border: `1px solid ${C.line}`, borderRadius: 6, padding: "16px 18px" }}>
            <div style={{ borderLeft: `2px solid ${C.gilt}`, paddingLeft: 10 }}>
              <div style={{ fontFamily: "Georgia, serif", fontSize: 16, color: C.ink }}>{title}</div>
              {hint && <div style={{ fontSize: 12, color: C.slate, marginTop: 2 }}>{hint}</div>}
            </div>
            <div style={{ marginTop: 12 }}>{children}</div>
          </div>
        );
      }

      function Stat({ label, value, accent }) {
        return (
          <div>
            <div style={{ fontSize: 11, color: C.slate, textTransform: "uppercase", letterSpacing: "0.04em" }}>{label}</div>
            <div style={{ fontSize: 17, fontWeight: 700, color: accent ? C.gilt : C.ink, fontFamily: "ui-monospace, monospace", marginTop: 2 }}>{value}</div>
          </div>
        );
      }

      const inputStyle = { width: "100%", padding: "8px 10px", borderRadius: 5, border: `1px solid ${C.line}`, background: C.surface, fontSize: 13, color: C.ink, marginTop: 4 };
      const labelStyle = { fontSize: 11.5, fontWeight: 600, color: C.slate, textTransform: "uppercase", letterSpacing: "0.03em" };

      function Field({ label, ...props }) {
        return (
          <label style={{ display: "block", marginBottom: 12 }}>
            <span style={labelStyle}>{label}</span>
            <input {...props} style={inputStyle} />
          </label>
        );
      }

      function Select({ label, value, onChange, options, optionLabels = {} }) {
        return (
          <label style={{ display: "block", marginBottom: 12 }}>
            <span style={labelStyle}>{label}</span>
            <select value={value} onChange={onChange} style={inputStyle}>
              {options.map((o) => (
                <option key={o} value={o}>{optionLabels[o] ?? (o || "—")}</option>
              ))}
            </select>
          </label>
        );
      }

      function Row({ children }) {
        return <div className="grid gap-3" style={{ gridTemplateColumns: "1fr 1fr", marginBottom: 12 }}>{children}</div>;
      }

      /* ======================================================================
         components/panels.jsx — Overview, Inventory, Collections, Shipments
      ====================================================================== */
      function Overview({ collections, maxColMagnitude, enriched }) {
        const pipeline = STATUSES.map((s) => ({ s, n: enriched.filter((i) => i.status === s).length }));
        const maxPipe = Math.max(1, ...pipeline.map((p) => p.n));
        return (
          <div className="grid gap-3" style={{ gridTemplateColumns: "1.4fr 1fr" }}>
            <Card title="Collections at a glance" hint="Bar length = pieces held or sold. Filled = sold, outline = in stock.">
              <div style={{ display: "flex", flexDirection: "column", gap: 14, marginTop: 4 }}>
                {collections.map((c) => {
                  const total = c.inStock + c.sold;
                  const w = (total / maxColMagnitude) * 100;
                  const soldW = total ? (c.sold / total) * 100 : 0;
                  return (
                    <div key={c.name}>
                      <div className="flex justify-between" style={{ fontSize: 13, marginBottom: 5 }}>
                        <span style={{ fontWeight: 600 }}>{c.name}</span>
                        <span style={{ color: C.slate }}>{c.inStock} in stock · {c.sold} sold</span>
                      </div>
                      <div style={{ height: 10, width: `${w}%`, minWidth: 24, background: C.surface, border: `1px solid ${C.cobaltSoft}`, borderRadius: 2, overflow: "hidden" }}>
                        <div style={{ height: "100%", width: `${soldW}%`, background: C.cobalt }} />
                      </div>
                    </div>
                  );
                })}
              </div>
            </Card>

            <Card title="Where the stock is" hint="Pieces by stage of the journey.">
              <div style={{ display: "flex", flexDirection: "column", gap: 12, marginTop: 4 }}>
                {pipeline.map(({ s, n }) => (
                  <div key={s} className="flex items-center gap-3">
                    <span style={{ width: 78, fontSize: 12.5, color: C.slate, textTransform: "capitalize" }}>{s}</span>
                    <div style={{ flex: 1, height: 22, background: C.porcelain, borderRadius: 3, overflow: "hidden" }}>
                      <div style={{ height: "100%", width: `${(n / maxPipe) * 100}%`, minWidth: n ? 22 : 0, background: STATUS_STYLE[s].bg, display: "flex", alignItems: "center", justifyContent: "flex-end", paddingRight: 8 }}>
                        <span style={{ fontSize: 12, fontWeight: 700, color: STATUS_STYLE[s].fg }}>{n || ""}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </Card>
          </div>
        );
      }

      function Inventory({ enriched, onRemove }) {
        return (
          <Card title="Inventory" hint="Each row is one physical piece. Margin appears once it's sold and its parcel costs are known.">
            <div style={{ overflowX: "auto", marginTop: 6 }}>
              <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13 }}>
                <thead>
                  <tr style={{ textAlign: "left", color: C.slate, borderBottom: `1px solid ${C.line}` }}>
                    {["Piece", "Collection", "Source", "Landed", "List", "Sold", "Margin", "Status", ""].map((h, i) => (
                      <th key={i} style={{ padding: "8px 10px", fontWeight: 600, whiteSpace: "nowrap", fontSize: 11.5, letterSpacing: "0.04em", textTransform: "uppercase" }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {enriched.map((it) => {
                    const st = STATUS_STYLE[it.status] || STATUS_STYLE.sourced;
                    return (
                      <tr key={it.id} style={{ borderBottom: `1px solid ${C.line}` }}>
                        <td style={{ padding: "9px 10px" }}>
                          <div style={{ fontWeight: 600 }}>{it.product}</div>
                          <div style={{ fontSize: 11, color: C.slate, fontFamily: "ui-monospace, monospace" }}>{it.id}</div>
                        </td>
                        <td style={{ padding: "9px 10px", color: C.slate }}>{it.collection}</td>
                        <td style={{ padding: "9px 10px", color: C.slate }}>{it.source}</td>
                        <td style={{ padding: "9px 10px", fontFamily: "ui-monospace, monospace" }}>
                          {money(it.landed)}
                          {it.estimated && <span title="parcel costs not yet logged" style={{ color: C.gilt, marginLeft: 4 }}>*</span>}
                        </td>
                        <td style={{ padding: "9px 10px", color: C.slate, fontFamily: "ui-monospace, monospace" }}>{it.listPrice ? money(it.listPrice) : "—"}</td>
                        <td style={{ padding: "9px 10px", fontFamily: "ui-monospace, monospace" }}>{it.salePrice ? money(it.salePrice) : "—"}</td>
                        <td style={{ padding: "9px 10px", fontFamily: "ui-monospace, monospace", fontWeight: 700, color: it.margin != null ? "#3f7a4d" : C.slate }}>{pct(it.margin)}</td>
                        <td style={{ padding: "9px 10px" }}>
                          <span style={{ background: st.bg, color: st.fg, padding: "3px 9px", borderRadius: 20, fontSize: 11.5, fontWeight: 600, whiteSpace: "nowrap" }}>{it.status}</span>
                        </td>
                        <td style={{ padding: "9px 10px" }}>
                          <button onClick={() => onRemove(it.id)} style={{ color: C.slate, background: "none" }} title="Remove"><Trash2 size={14} /></button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <div style={{ fontSize: 11.5, color: C.slate, marginTop: 10 }}>
              <span style={{ color: C.gilt }}>*</span> estimate — this piece will travel but its parcel costs aren't logged yet, so its final margin isn't settled.
            </div>
          </Card>
        );
      }

      function Collections({ collections, enriched }) {
        return (
          <div className="grid gap-3" style={{ gridTemplateColumns: "repeat(2, minmax(0,1fr))" }}>
            {collections.map((c) => {
              const pieces = enriched.filter((i) => (i.collection || "Unassigned") === c.name);
              return (
                <Card key={c.name} title={c.name} hint={c.brand}>
                  <div className="flex gap-6" style={{ margin: "6px 0 12px" }}>
                    <Stat label="In stock" value={c.inStock} />
                    <Stat label="Sold" value={c.sold} />
                    <Stat label="Profit" value={money(c.profit)} accent />
                    <Stat label="Held value" value={money(c.stockValue)} />
                  </div>
                  <div style={{ borderTop: `1px solid ${C.line}`, paddingTop: 10 }}>
                    {pieces.map((p) => (
                      <div key={p.id} className="flex items-center justify-between" style={{ fontSize: 12.5, padding: "3px 0" }}>
                        <span>{p.product}</span>
                        <span style={{ color: STATUS_STYLE[p.status].fg, fontWeight: 600, fontSize: 11.5 }}>{p.status}</span>
                      </div>
                    ))}
                  </div>
                </Card>
              );
            })}
          </div>
        );
      }

      function Shipments({ shipments, enriched, onRemove }) {
        return (
          <div className="grid gap-3" style={{ gridTemplateColumns: "repeat(2, minmax(0,1fr))" }}>
            {shipments.map((s) => {
              const pieces = enriched.filter((i) => i.shipment === s.id);
              const parcelCost = (s.outbound || 0) + (s.customs || 0);
              return (
                <Card key={s.id} title={s.id} hint={s.note}>
                  <div className="flex gap-6" style={{ margin: "6px 0 12px" }}>
                    <Stat label="Outbound" value={money(s.outbound)} />
                    <Stat label="Customs" value={money(s.customs)} />
                    <Stat label="Parcel total" value={money(parcelCost)} accent />
                    <Stat label="Pieces" value={pieces.length} />
                  </div>
                  <div style={{ borderTop: `1px solid ${C.line}`, paddingTop: 10 }}>
                    {pieces.map((p) => (
                      <div key={p.id} className="flex items-center justify-between" style={{ fontSize: 12.5, padding: "3px 0" }}>
                        <span>{p.product}</span>
                        <span style={{ color: C.slate, fontFamily: "ui-monospace, monospace" }}>+{money(p.apportioned)} share</span>
                      </div>
                    ))}
                    {!pieces.length && <div style={{ fontSize: 12, color: C.slate }}>No pieces assigned to this parcel yet.</div>}
                  </div>
                  <div style={{ marginTop: 10, fontSize: 11.5, color: C.slate }}>Sent {s.date}</div>
                  <button onClick={() => onRemove(s.id)} className="flex items-center gap-1" style={{ color: C.slate, background: "none", fontSize: 12, marginTop: 8 }}>
                    <Trash2 size={13} /> Remove parcel
                  </button>
                </Card>
              );
            })}
          </div>
        );
      }

      /* ======================================================================
         components/forms.jsx — Modal, ItemForm, ShipmentForm
      ====================================================================== */
      function Modal({ title, children, onClose, onSave }) {
        return (
          <div onClick={onClose} style={{ position: "fixed", inset: 0, background: "rgba(22,35,63,0.4)", display: "flex", alignItems: "flex-start", justifyContent: "center", padding: "6vh 16px", zIndex: 50 }}>
            <div onClick={(e) => e.stopPropagation()} style={{ background: C.porcelain, borderRadius: 8, width: "100%", maxWidth: 540, boxShadow: "0 20px 60px rgba(22,35,63,0.3)", border: `1px solid ${C.line}` }}>
              <div className="flex items-center justify-between" style={{ padding: "16px 20px", borderBottom: `2px solid ${C.gilt}` }}>
                <div style={{ fontFamily: "Georgia, serif", fontSize: 19 }}>{title}</div>
                <button onClick={onClose} style={{ background: "none", color: C.slate }}><X size={18} /></button>
              </div>
              <div style={{ padding: "18px 20px", maxHeight: "62vh", overflowY: "auto" }}>{children}</div>
              <div className="flex justify-end gap-2" style={{ padding: "14px 20px", borderTop: `1px solid ${C.line}` }}>
                <button onClick={onClose} style={btnGhost}>Cancel</button>
                <button onClick={onSave} style={btnPrimary}>Save</button>
              </div>
            </div>
          </div>
        );
      }

      function ItemForm({ onClose, onSave, shipments, existing }) {
        const [f, setF] = useState({
          id: "", product: "", collection: "", brand: "", source: "eBay UK",
          purchase: "", inbound: "", status: "sourced", listPrice: "", salePrice: "", channel: "", shipment: "",
        });
        const set = (k) => (e) => setF({ ...f, [k]: e.target.value });
        const doSave = () => {
          const id = f.id.trim() || `ITEM-${Date.now().toString().slice(-5)}`;
          if (existing.some((x) => x.id === id)) { alert("That piece code already exists — give it a unique one."); return; }
          onSave({
            id, product: f.product || "Untitled piece", collection: f.collection || "Unassigned", brand: f.brand,
            source: f.source, purchase: +f.purchase || 0, inbound: +f.inbound || 0, status: f.status,
            listPrice: f.listPrice ? +f.listPrice : null, salePrice: f.salePrice ? +f.salePrice : null,
            channel: f.channel || null, shipment: f.shipment || null,
          });
        };
        return (
          <Modal title="Add a piece" onClose={onClose} onSave={doSave}>
            <Row><Field label="Piece code" placeholder="VB-BEN-004 (auto if blank)" value={f.id} onChange={set("id")} /><Field label="Product / model" placeholder="Benedikt teapot" value={f.product} onChange={set("product")} /></Row>
            <Row><Field label="Collection" placeholder="V&B Benedikt" value={f.collection} onChange={set("collection")} /><Field label="Brand" placeholder="Villeroy & Boch" value={f.brand} onChange={set("brand")} /></Row>
            <Row>
              <Select label="Source" value={f.source} onChange={set("source")} options={["eBay UK", "Vinted", "Subito.it", "Leboncoin", "Other"]} />
              <Field label="Purchase price (£)" type="number" value={f.purchase} onChange={set("purchase")} />
            </Row>
            <Row>
              <Field label="Inbound shipping (£)" type="number" value={f.inbound} onChange={set("inbound")} />
              <Select label="Status" value={f.status} onChange={set("status")} options={STATUSES} />
            </Row>
            <Row>
              <Field label="List price (£)" type="number" value={f.listPrice} onChange={set("listPrice")} />
              <Field label="Sale price (£)" type="number" value={f.salePrice} onChange={set("salePrice")} />
            </Row>
            <Row>
              <Field label="Sale channel" placeholder="Avito" value={f.channel} onChange={set("channel")} />
              <Select label="Parcel" value={f.shipment} onChange={set("shipment")} options={["", ...shipments.map((s) => s.id)]} optionLabels={{ "": "— none yet —" }} />
            </Row>
          </Modal>
        );
      }

      function ShipmentForm({ onClose, onSave, existing }) {
        const [f, setF] = useState({ id: "", date: new Date().toISOString().slice(0, 10), outbound: "", customs: "", note: "" });
        const set = (k) => (e) => setF({ ...f, [k]: e.target.value });
        const doSave = () => {
          const id = f.id.trim() || `P-${(existing.length + 1).toString().padStart(3, "0")}`;
          if (existing.some((x) => x.id === id)) { alert("That parcel code already exists."); return; }
          onSave({ id, date: f.date, outbound: +f.outbound || 0, customs: +f.customs || 0, note: f.note });
        };
        return (
          <Modal title="Log a parcel" onClose={onClose} onSave={doSave}>
            <Row><Field label="Parcel code" placeholder="P-003 (auto if blank)" value={f.id} onChange={set("id")} /><Field label="Date sent" type="date" value={f.date} onChange={set("date")} /></Row>
            <Row><Field label="Outbound shipping (£)" type="number" value={f.outbound} onChange={set("outbound")} /><Field label="Customs paid (£)" type="number" value={f.customs} onChange={set("customs")} /></Row>
            <Field label="Note" placeholder="What's in it / anything customs did" value={f.note} onChange={set("note")} />
            <div style={{ fontSize: 12, color: C.slate, marginTop: 10 }}>
              Assign pieces to this parcel from each piece's record. Its outbound + customs cost then spreads across those pieces by value.
            </div>
          </Modal>
        );
      }

      /* ======================================================================
         App.jsx — masthead, KPI band, tabs, panels, modals
      ====================================================================== */
      function App() {
        const [tab, setTab] = useState("overview");
        const [modal, setModal] = useState(null); // 'item' | 'shipment' | null

        const initial = load();
        const [items, setItems] = useState(initial?.items ?? SEED.items);
        const [shipments, setShipments] = useState(initial?.shipments ?? SEED.shipments);

        useEffect(() => { save({ items, shipments }); }, [items, shipments]);

        const enriched = useMemo(() => enrich(items, shipments), [items, shipments]);
        const kpi = useMemo(() => rollups(enriched), [enriched]);
        const collections = useMemo(() => byCollection(enriched), [enriched]);
        const maxColMagnitude = Math.max(1, ...collections.map((c) => c.inStock + c.sold));

        const removeItem = (id) => setItems((xs) => xs.filter((x) => x.id !== id));
        const removeShipment = (id) => {
          setShipments((xs) => xs.filter((x) => x.id !== id));
          setItems((xs) => xs.map((x) => (x.shipment === id ? { ...x, shipment: null } : x)));
        };
        const resetSeed = () => { setItems(SEED.items); setShipments(SEED.shipments); };

        return (
          <div style={{ background: C.porcelain, minHeight: "100%" }}>
            <div className="mx-auto" style={{ maxWidth: 1120, padding: "28px 20px 48px" }}>
              {/* Masthead */}
              <header className="flex items-end justify-between" style={{ borderBottom: `2px solid ${C.gilt}`, paddingBottom: 14 }}>
                <div>
                  <div style={{ letterSpacing: "0.32em", fontSize: 11, color: C.gilt, fontWeight: 600 }}>
                    VINTAGE CHINA · SILVER · STOCK REGISTRY
                  </div>
                  <h1 style={{ fontFamily: "Georgia, 'Times New Roman', serif", fontSize: 34, lineHeight: 1.05, marginTop: 6, color: C.ink }}>
                    Porcelain Freaks
                  </h1>
                  <div style={{ color: C.slate, fontSize: 13, marginTop: 4 }}>
                    Every piece, from source to sold — with the real landed cost behind each margin.
                  </div>
                </div>
                <div className="flex gap-2">
                  <button onClick={() => setModal("shipment")} className="flex items-center gap-1" style={btnGhost}>
                    <Ship size={15} /> Log parcel
                  </button>
                  <button onClick={() => setModal("item")} className="flex items-center gap-1" style={btnPrimary}>
                    <Plus size={15} /> Add piece
                  </button>
                </div>
              </header>

              {/* KPI band */}
              <section className="grid gap-3" style={{ gridTemplateColumns: "repeat(6, minmax(0,1fr))", marginTop: 20 }}>
                <Kpi icon={<TrendingUp size={16} />} label="Revenue"     value={money(kpi.revenue)} />
                <Kpi icon={<Wallet size={16} />}     label="Profit"      value={money(kpi.profit)} accent />
                <Kpi icon={<Archive size={16} />}    label="Stock value" value={money(kpi.stockValue)} sub="capital tied up" />
                <Kpi icon={<Boxes size={16} />}      label="In stock"    value={kpi.inStock} />
                <Kpi icon={<Package size={16} />}    label="Sold"        value={kpi.soldCount} />
                <Kpi icon={<CircleDot size={16} />}  label="Avg margin"  value={pct(kpi.avgMargin)} />
              </section>

              {/* Tabs */}
              <nav className="flex gap-1" style={{ marginTop: 24, borderBottom: `1px solid ${C.line}` }}>
                {[
                  ["overview", "Overview", <Layers size={15} />],
                  ["inventory", "Inventory", <Boxes size={15} />],
                  ["collections", "Collections", <Archive size={15} />],
                  ["shipments", "Parcels", <Truck size={15} />],
                ].map(([key, label, icon]) => (
                  <button key={key} onClick={() => setTab(key)} className="flex items-center gap-2"
                    style={{
                      padding: "9px 16px", fontSize: 13.5, fontWeight: 600,
                      color: tab === key ? C.cobalt : C.slate,
                      borderBottom: tab === key ? `2px solid ${C.cobalt}` : "2px solid transparent",
                      marginBottom: -1, background: "none",
                    }}>
                    {icon}{label}
                  </button>
                ))}
              </nav>

              {/* Panels */}
              <div style={{ marginTop: 22 }}>
                {tab === "overview" && <Overview collections={collections} maxColMagnitude={maxColMagnitude} enriched={enriched} />}
                {tab === "inventory" && <Inventory enriched={enriched} onRemove={removeItem} />}
                {tab === "collections" && <Collections collections={collections} enriched={enriched} />}
                {tab === "shipments" && <Shipments shipments={shipments} enriched={enriched} onRemove={removeShipment} />}
              </div>

              <footer className="flex items-center justify-between" style={{ marginTop: 40, paddingTop: 14, borderTop: `1px solid ${C.line}`, color: C.slate, fontSize: 12 }}>
                <span>Landed cost = purchase + inbound shipping + this piece's share of its parcel (outbound + customs), apportioned by value.</span>
                <button onClick={resetSeed} className="flex items-center gap-1" style={{ color: C.slate, background: "none", fontSize: 12 }}>
                  <RotateCcw size={13} /> Reset to sample
                </button>
              </footer>
            </div>

            {modal === "item" && <ItemForm onClose={() => setModal(null)} onSave={(it) => { setItems((xs) => [it, ...xs]); setModal(null); }} shipments={shipments} existing={items} />}
            {modal === "shipment" && <ShipmentForm onClose={() => setModal(null)} onSave={(s) => { setShipments((xs) => [s, ...xs]); setModal(null); }} existing={shipments} />}
          </div>
        );
      }

      createRoot(document.getElementById("root")).render(
        <React.StrictMode>
          <App />
        </React.StrictMode>
      );
    </script>
  </body>
</html>
